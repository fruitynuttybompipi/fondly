  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Butter pill for the main action.",
      "html": "<button class=\"ds-btn\">Save my happy things</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:10px 20px;border:0;border-radius:999px;cursor:pointer;font:600 1rem/1.2 'Shantell Sans','Comic Sans MS',sans-serif;color:#463a4f;background:#ffe08a;box-shadow:0 2px 0 rgb(62 44 78/.14),0 10px 18px -12px rgb(62 44 78/.6);transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-btn:hover{transform:translateY(-2px) rotate(-.6deg)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:3px dashed #a585dd;outline-offset:3px}"
    },
    {
      "name": "Pink Button",
      "kind": "button",
      "refersTo": "button-pink",
      "description": "Blush pill for keeping a moment.",
      "html": "<button class=\"ds-btn-pink\">Keep it ♡</button>",
      "css": ".ds-btn-pink{min-height:46px;padding:10px 20px;border:0;border-radius:999px;cursor:pointer;font:600 1rem/1.2 'Shantell Sans',sans-serif;color:#463a4f;background:#ffc6d1;box-shadow:0 2px 0 rgb(62 44 78/.14),0 10px 18px -12px rgb(62 44 78/.6);transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-btn-pink:hover{transform:translateY(-2px) rotate(-.6deg)}.ds-btn-pink:focus-visible{outline:3px dashed #a585dd;outline-offset:3px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet secondary action with an inset rule ring.",
      "html": "<button class=\"ds-btn-ghost\">Not now</button>",
      "css": ".ds-btn-ghost{min-height:46px;padding:10px 20px;border:0;border-radius:999px;cursor:pointer;font:600 1rem/1.2 'Shantell Sans',sans-serif;color:#463a4f;background:transparent;box-shadow:inset 0 0 0 2px rgb(70 58 79/.12);transition:background-color .2s}.ds-btn-ghost:hover{background:rgb(70 58 79/.06)}.ds-btn-ghost:focus-visible{outline:3px dashed #a585dd;outline-offset:3px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip-on",
      "description": "Filter pill; selected gets a lavender ring.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-on\">1 year ago</button><button class=\"ds-chip\">2 years ago</button></div>",
      "css": ".ds-chips{display:flex;gap:6px;padding:12px;background:#d9c7f6}.ds-chip{border:0;border-radius:999px;padding:6px 14px;font:.88rem 'Shantell Sans',sans-serif;cursor:pointer;background:rgb(255 255 255/.55);color:#463a4f}.ds-chip.ds-on{background:#fffdf8;box-shadow:inset 0 0 0 2px #a585dd;font-weight:600}.ds-chip:focus-visible{outline:3px dashed #a585dd;outline-offset:3px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Paper field with inset rule ring; blush on focus.",
      "html": "<label class=\"ds-field\">Data repository<input placeholder=\"owner/repo\"></label>",
      "css": ".ds-field{display:grid;gap:4px;font:600 .95rem 'Shantell Sans',sans-serif;color:#463a4f}.ds-field input{font:400 1rem 'Shantell Sans',sans-serif;color:#463a4f;min-height:48px;padding:10px 14px;border-radius:14px;border:0;background:#fffaf0;box-shadow:inset 0 0 0 2px rgb(70 58 79/.12)}.ds-field input:focus{outline:none;box-shadow:inset 0 0 0 2px #ef8aa5}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab-active-icon",
      "description": "Mobile bottom tabs; active icon sits in a butter pill.",
      "html": "<nav class=\"ds-tabs\"><a aria-current=\"page\"><svg viewBox=\"0 0 24 24\" class=\"ds-i\"><path d=\"M4 11l8-7 8 7v9H4z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>Home</a><a><svg viewBox=\"0 0 24 24\" class=\"ds-i\"><rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>Journal</a><a><svg viewBox=\"0 0 24 24\" class=\"ds-i\"><rect x=\"4\" y=\"5\" width=\"14\" height=\"14\" rx=\"2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>Gallery</a></nav>",
      "css": ".ds-tabs{display:grid;grid-template-columns:repeat(3,1fr);padding:6px;background:#fffdf8;border-radius:22px 22px 0 0;box-shadow:0 -6px 24px -10px rgb(62 44 78/.3)}.ds-tabs a{display:grid;justify-items:center;gap:2px;padding:6px 2px;font:.78rem/1.15 'Shantell Sans',sans-serif;color:#6a5a75;text-decoration:none;cursor:pointer;border-radius:14px}.ds-i{width:46px;height:30px;padding:3px 10px;border-radius:999px;transition:background-color .25s cubic-bezier(.16,1,.3,1)}.ds-tabs a[aria-current]{color:#463a4f;font-weight:600}.ds-tabs a[aria-current] .ds-i{background:#ffe08a}.ds-tabs a:focus-visible{outline:3px dashed #a585dd;outline-offset:3px}"
    },
    {
      "name": "Taped Sheet",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Cream card with cut-paper corners, washi tape and photo-corner mount.",
      "html": "<div class=\"ds-sheet\"><span class=\"ds-tape\"></span><h3>Daily Little Reminder</h3><p>Say thank you to someone who won't expect it.</p></div>",
      "css": ".ds-sheet{position:relative;margin:20px 12px;padding:22px 18px 18px;background:#fffdf8;color:#463a4f;border-radius:6px 18px 8px 14px;rotate:-.6deg;box-shadow:0 1px 0 rgb(62 44 78/.08),0 16px 30px -20px rgb(62 44 78/.5);font:1rem/1.55 'Shantell Sans',sans-serif}.ds-sheet h3{margin:0 0 4px;font:400 1.35rem/1.12 'Gochi Hand',cursive}.ds-sheet p{margin:0}.ds-sheet::after{content:'';position:absolute;right:10px;bottom:10px;width:22px;height:22px;background:linear-gradient(-45deg,#d9c7f6 50%,transparent 50%);border-radius:0 0 4px 0}.ds-tape{position:absolute;top:-11px;right:14px;width:92px;height:24px;rotate:5deg;opacity:.88;background:repeating-linear-gradient(-45deg,rgb(255 255 255/.35) 0 5px,transparent 5px 10px),#cbe3bf}"
    },
    {
      "name": "Capture Card",
      "kind": "custom",
      "refersTo": "capture-card",
      "description": "Butter organic-cornered call to start today.",
      "html": "<a class=\"ds-capture\" href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\" stroke=\"#463a4f\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg><span><b>Capture Today's Happy Moments</b><small>2/5 collected so far</small></span></a>",
      "css": ".ds-capture{display:flex;align-items:center;gap:14px;padding:16px 20px;text-decoration:none;background:#ffe08a;color:#463a4f;border-radius:26px 20px 28px 22px/22px 28px 20px 26px;box-shadow:0 3px 0 rgb(62 44 78/.14),0 18px 28px -18px rgb(62 44 78/.65);transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-capture:hover{transform:translateY(-3px) rotate(-.5deg)}.ds-capture:focus-visible{outline:3px dashed #a585dd;outline-offset:3px}.ds-capture svg{width:44px;height:44px;padding:9px;border-radius:50%;background:rgb(255 255 255/.6);flex:none}.ds-capture b{display:block;font:400 1.45rem/1.1 'Gochi Hand',cursive}.ds-capture small{font:.9rem 'Shantell Sans',sans-serif;opacity:.85}"
    },
    {
      "name": "Mini Polaroid",
      "kind": "card",
      "refersTo": "polaroid",
